NODE_ENV=development
LOG_LEVEL=info
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=agentseclab
QDRANT_URL=http://127.0.0.1:6333
REDIS_URL=redis://127.0.0.1:6379
AGENT_HOST=127.0.0.1
AGENT_PORT=3001
# A2A peer links; empty = control not wired (fail-closed, no dispatch)
ORCHESTRATOR_A2A_URL=
RECON_A2A_URL=
KNOWLEDGE_A2A_URL=
REPORT_A2A_URL=
# Base URL of the internal Security Token Service. Empty => no run token can
# be minted and no child delegation occurs (fail-closed).
STS_URL=
STS_HOST=127.0.0.1
STS_PORT=3002
# ---------------------------------------------------------------------------
# User authentication (API gateway only, HS256). Dedicated symmetric secret.
# NEVER shared with the STS or worker agents.
# ---------------------------------------------------------------------------
USER_JWT_SECRET=
USER_JWT_ISS=agent-sec-lab-user
USER_JWT_AUD=api-gateway
USER_TOKEN_TTL=1800
# ---------------------------------------------------------------------------
# Workload tokens (STS only, asymmetric RS256). The private key is held ONLY
# by the STS process; every other service holds STS_PUBLIC_KEY(S).
# ---------------------------------------------------------------------------
STS_ISS=agent-sec-lab
STS_KEY_ID=sts-key-v1
# Inline PEM or "file:/path/to/key.pem" (STS only)
STS_PRIVATE_KEY=
# Single public verification PEM (uses STS_KEY_ID)
STS_PUBLIC_KEY=
# JSON map of kid -> public PEM for rotation, e.g.
# {"sts-key-v1":"-----BEGIN PUBLIC KEY-----..."}
STS_PUBLIC_KEYS=
WORKLOAD_TOKEN_TTL=300
RUN_TOKEN_TTL=1800
CHILD_TOKEN_TTL=600
